C ELM39C              PARAMETERS FOR LIMITS
C
C DPARL      VALUE OF LIMIT
C TYPEL      TYPE CODE TO WHICH LIMITED PARAMETER BELONGS
C NPARL      NUMBER OF LIMITED PARAMETER
C LTYPE      LOWER OR UPPER OR ABSOLUTE LIMIT
C
      INTEGER         TYPEL, NPARL, LTYPE
      REAL            DPARL
C
      COMMON /ELM39C/ DPARL, TYPEL, NPARL, LTYPE
