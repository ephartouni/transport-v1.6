C NPLIN      CORRESPONDENCE BETWEEN POSITIONAL AND KEYWORD PARAMETERS
C
C NPLIN      CORRESPONDENCE FOR MOST ELEMENTS
C NPUPD      CORRESPONDENCE FOR ELLIPTICAL SLIT
C NPBEND     CORRESPONDENCE FOR BENDING MAGNET 
C NPRBND     CORRESPONDENCE FOR RBEND AND SBEND
C NPHKCK     CORRESPONDENCE FOR HKICK AND VKICK
C
      INTEGER        NPLIN(20), NPUPD(4), NPBEND(10), NPRBND(10), 
     1               NPHKCK(4)
C
      COMMON /NPLIN/ NPLIN, NPUPD, NPBEND, NPRBND, NPHKCK
