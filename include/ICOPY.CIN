C                     INDICES RELATED TO EDITING OF DATA
C
C ICOPY                  BEGINNING OF RANGE FOR REVISED REFERENCES
C                        TO PREVIOUSLY DEFINED PARAMETER
C IANEW                  REVISED REFERENCE FOR PARAMETER ON INSERTED
C                        ELEMENT
C IB100                  LOWER END OF SEARCH RANGE FOR PARAMETER FOR
C                        WHICH REFERENCE EXISTS
C I100                   PARAMETER INDEX FOR WHICH REFERENCE IS BEING
C                        REVISED
C
      COMMON /ICOPY/  ICOPY, IANEW, IB100, I100
      INTEGER         ICOPY, IANEW, IB100, I100
