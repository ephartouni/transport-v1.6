C OC         FLOOR COORDINATION TRANSFORMATIONS
C
C O(4,3,3)        TRANSFORMATIONS BETWEEN COORDINATE SYSTEMS.
C OV(3,3,NPVAR)   ACCUMULATED DERIVATIVES OF COORDINATE ROTATION MATRIX
C X0(4,3)         LOCATION VECTORS WRT EACH OF THE FOUR COORDINATE SYSTEMS
C X0V(3,NPVAR)    ACCUMULATED DERIVATIVES OF FLOOR POSITIONS
C
C
      REAL            O(4,3,3), OV(3,3,NPVAR), X0(4,3), X0V(3,NPVAR)
      REAL            OL(36), X0L(12)
      EQUIVALENCE     (O(1,1,1),OL(1)), (X0(1,1),X0L(1))
C
      COMMON /OC/     O, OV, X0, X0V
