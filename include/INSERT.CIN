C INSERT	      CONTROLS FOR INSERTING MODIFICATIONS TO DATA
C
C REMOVE                 TRUE IF REMOVE COMMAND IS BEING EXECUTED
C INSERT                 TRUE IF INSERT COMMAND IS BEING EXECUTED
C BEFI                   TRUE IF INSERT COMMAND IS BEFORE THE SPECIFIED
C                        ELEMENT
C NINSRT                 0 IF SEMICOLON ENCOUNTERED AFTER BEFORE, AFTER,
C                        OR REMOVE COMMAND;  1 IF NO SEMICOLON ENCOUNTERED
C
      LOGICAL         REMOVE, INSERT, BEFI
      INTEGER         NINSRT
C
      COMMON /INSERT/ REMOVE, INSERT, BEFI, NINSRT
