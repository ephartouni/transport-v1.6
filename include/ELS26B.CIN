C ELS26B     TEMPORARY STORAGE FOR ELM26B
C
C PRAN2S         TEMPORARY STORAGE FOR PRAN2
C PRAN3S         TEMPORARY STORAGE FOR PRAN3
C PRAN4S(15)     TEMPORARY STORAGE FOR PRAN4
C PRAN5S(5)      TEMPORARY STORAGE FOR PRAN5
C PRAN7S(6)      TEMPORARY STORAGE FOR PRAN7
C PRN11S(4)      TEMPORARY STORAGE FOR PRAN11
C PRN18S(4)      TEMPORARY STORAGE FOR PRAN18
C PRN19S(3)      TEMPORARY STORAGE FOR PRAN19
C PRN20S         TEMPORARY STORAGE FOR PRAN20
C PRN25S(4)      TEMPORARY STORAGE FOR PRAN25
C PRN28S(9)      TEMPORARY STORAGE FOR PRAN28
C PRN34S(5)      TEMPORARY STORAGE FOR PRAN34
C PRN43S(6)      TEMPORARY STORAGE FOR PRAN43
C
      REAL            PRAN2S(4), PRAN3S, PRAN4S(15), PRAN5S(5) 
      REAL            PRAN7S(6), PRN11S(4), PRN18S(4), PRN19S(3)
      REAL            PRN20S, PRN25S(4), PRN28S(9), PRN34S(5)
      REAL            PRN43S(6)
C
      COMMON /ELS26B/ PRAN2S, PRAN3S, PRAN4S, PRAN5S, PRAN7S, 
     >                PRN11S, PRN18S, PRN19S, PRN20S, PRN25S, 
     >                PRN28S, PRN34S, PRN43S
