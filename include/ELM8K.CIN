C ELM8K    TRANSFORMATION MATRICES BETWEEN COORDINATES FOR MISALIGNMENTS
C
C RM(3,3)      ROTATION MATRIX FOR (X,Y,Z) IN MISALIGNMENT
C MM(3,3)      ROTATION MATRIX FOR VECTOR (X',Y',1)
C RMV(3)
C VDIS(3)      LOCAL DISPLACEMENT DUE TO MISALIGNMENT
C VROT(3)      LOCAL ROTATION DUE TO MISALIGNMENT
C THMIS        COMBINED ANGLE OF THREE ROTATIONAL MISALIGNMENT
C CSM          COSINE OF MISALIGNMENT ROTATION ANGLE
C SNM          SINE OF MISALIGNMENT ROTATION ANGLE
C ZNM          1 - CSM
C
      REAL            RM(3,3), MM(3,3), RMV(3), VDIS(3), VROT(3)
      REAL            THMIS, CSM, SNM, ZNM
C
      COMMON /ELM8K/  RM, MM, RMV, VDIS, VROT, THMIS, CSM, SNM, ZNM
