C TRNSPRT_PARAM       PARAMETERS USED IN VARIOUS ARRAY DIMENSIONS
C                     LIST THIS INCLUDE FILE BEFORE ALL OTHERS
C
C IDALIM used in DATA0A, ISTLIM used in DATA1A
	INTEGER  IDALIM, ISTLIM
	PARAMETER (IDALIM = 12001)
	PARAMETER (ISTLIM = 4001)
C
C MAXLST used in LPDATA, MAXPAR used in PARDAT
	INTEGER  MAXLST, MAXPAR
	PARAMETER (MAXLST = 20)
	PARAMETER (MAXPAR = 100)
C
C NELEM used in KELEM, NELMCT used in NELMS
	INTEGER  NELEM, NELMCT
	PARAMETER (NELEM = 64)
	PARAMETER (NELMCT = 48)
C
C NPVAR used in DATA2B, NSYM used in SVALUE
	INTEGER NPVAR, NSYM
	PARAMETER (NPVAR = 20)
	PARAMETER (NSYM = 10)
C
