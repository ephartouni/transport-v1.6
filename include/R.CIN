C R          FIRST-ORDER MATRICES FOR A SINGLE ELEMENT
C
C R(6,6)     FIRST ORDER TRANSFER MATRIX.
C RV(6,6)    PARTIALS MATRIX FOR ONE OF THE VARIED PARAMETERS
C
      REAL            R(6,6), RV(6,6)
      REAL            RL(36), RVL(36)
      EQUIVALENCE     (R(1,1),RL(1)), (RV(1,1),RVL(1))
C
      COMMON /R/      R, RV
