C ELM8A        ALIGN  INPUT OR IMMEDIATELY CALCULATED QUANTITIES
C
C IR           INDEX TELLING IF MISALIGNMENT IS SINCE THE LAST ELEMENT, 
C                        R1, OR R2 UPDATES.
C RORC         INDEX ON A MISALIGNMENT CARD.
C TYT          PARTIAL DECODING ON INDEX ON MISALIGNMENT CARD.
C ALIGN        TRUE IF A MISALIGNMENT IS INCLUDED IN THIS RUN.
C                        INCLUDED IN MISALIGNMENT CALCULATION
C TMK          INDEX INDICATING THE PIVOT POINT OF A MISALIGNMENT
C FEO          TRUE IF ONLY FOCUSING EFFECT OF MISALIGNMENT IS TO BE COMPUTED
C LFM          INDEX INDICATING WHETHER MISALIGNMENT IS KNOWN OR UNKNOWN
C LTAB         INDEX INDICATING WHETHER EFFECT OF MISALIGNMENT IS DISPLAYED 
C                      IN BEAM MATRIX OR TABLE
C CHORD        TRUE IF MISALIGNMENT Z AXIS IS CHORD OF BENDING MAGNET
C MCFO         INDEX GIVING ORIGIN AND REFERENCE AXES FOR MISALIGNMENT
C ALO(2)       TRUE IF AUTOMATIC MAGNET MISALIGNMENT FEATURE IS INVOKED
C NUNC         NUMBER OF UNCERTAIN MISALIGNMENTS REFERRING TO A GIVEN
C              ALIGNMENT MARKER
C NKNOW        NUMBER OF KNOWN MISALIGNMENTS REFERRING TO A GIVEN
C              ALIGNMENT MARKER
C
      LOGICAL        ALIGN, FEO, CHORD, ALO(2)
      INTEGER        RORC, TMK, TYT
C
      COMMON /ELM8A/ IR, RORC, TYT, ALIGN, TMK, FEO, LFM, LTAB, CHORD,
     1               MCFO, ALO, NUNC, NKNOW
