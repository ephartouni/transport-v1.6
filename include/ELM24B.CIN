C ELM24B              REFERENCE MARKERS FOR DEFINED SECTION
C
C NDC(10)     CALLING LOCATION FOR DEFINED SECTION
C NDS(10)     SIGN OF DIRECTION OF MOTION FOR DEFINED SECTION
C NUC(10)     CALLING POSITION FOR DUMMY ARGUMENT
C NUS(10)     DIRECTION OF MOTION FOR REAL ARGUMENT
C NDLEV       LEVEL OF PRESENT NESTING FOR BEAM SUBLINES
C NULEV       LEVEL INDICATOR FOR DUMMY ARGUMENTS
C
      INTEGER         NDC(10), NDS(10), NUC(10), NUS(10), NDLEV, 
     1                NULEV
C
      COMMON /ELM24B/ NDC, NDS, NUC, NUS, NDLEV, NULEV
