C ELM4D               HORIZONTAL AND VERTICAL TRANSFER MATRIX ELEMENTS
C
C CX        HORIZONTAL COSINELIKE TRAJECTORY
C SX        HORIZONTAL SINELIKE TRAJECTORY
C DISP      DISPERSION FUNCTION
C DDISP     DERIVATIVE OF DISPERSION FUNCTION
C CY        VERTICAL COSINELIKE TRAJECTORY
C SY        VERTICAL SINELIKE TRAJECTORY
C DISN      (1 - COS(KXL)) / KX**2
C DSVN      (1 - COS(KYL)) / KY**2
C R56       R(5,6) FOR A BENDING MAGNET
C CSAL      COSINE OF BEND ANGLE
C SNAL      SINE OF BEND ANGLE
C
      COMMON /ELM4D/  CX, SX, DISP, DDISP, CY, SY, DISN, DSVN, 
     1                R56, CSAL, SNAL
