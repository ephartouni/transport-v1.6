C RDWRDS              PARAMETERS TO DESCRIBE ELEMENT BEING READ
C
C NTYPE                  NUMERICAL TYPE CODE OF ELEMENT
C NWORD                  NUMBER OF PARAMETERS USED TO DESCRIBE ELEMENT
C                        (INCLUDING TYPE CODE)
C NVARY                  NUMBER OF DIGITS IN SPECIFIED VARY CODE
C NDESC                  BINARY DESCRIPTOR INDICATING WHICH PARAMETERS
C                        ARE USED TO SPECIFY ELEMENT
C NMARKS                 NUMBER OF MARKERS ENCOUNTERED IN DATA
C
      INTEGER         NTYPE, NWORD, NVARY, NDESC, NMARKS
C
      COMMON /RDWRDS/ NTYPE, NWORD, NVARY, NDESC, NMARKS
