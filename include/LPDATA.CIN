C LPDATA              KEEP TRACK OF BEAM LIST AS IT IS DECODED
C
C IUSED                  LEVEL OF NESTING OF PARENTHESES
C ILDAT(MAXLST,2)        (*,1) -- SPECIFICATION OF REFLECTION AND
C                        REPETITION FOR SUBLIST
C                        (*,2) -- 1 FOR LINE, 2 FOR SUBLINE,
C                        3 FOR ARGUMENT LIST, 4 FOR ERROR
C
      COMMON /LPDATA/ IUSED, ILDAT(MAXLST,2)
      INTEGER         IUSED, ILDAT
