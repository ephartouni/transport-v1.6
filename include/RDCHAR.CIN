C RDCHAR    HOLLERITH CODES USED FOR FREE-FORMAT DECODING
C
C TABLE(39) DIGITS AND LETTERS
C PLUS      +
C MINUS     -
C BLANK     BLANK SPACE
C PERIOD    .
C SPEC(10)  , ; * $ " ' = / ( )
C
      CHARACTER*1     TABLE(39), PLUS, MINUS, BLANK, PERIOD, SPEC(10)
      CHARACTER*1     COMMA, SEMI, ASTER, DOLLAR, QUOTE, APOST, EQUAL,
     1                SLASH, PARENO, PARENC
      CHARACTER       ALFNUM*39, ALPHA*29, NUMB*10, SPECL*10
      EQUIVALENCE     (COMMA,SPEC(1)), (SEMI,SPEC(2)),
     1                (ASTER,SPEC(3)), (DOLLAR,SPEC(4)),
     2                (QUOTE,SPEC(5)), (APOST,SPEC(6)),
     3                (EQUAL,SPEC(7)), (SLASH,SPEC(8)),
     4                (PARENO,SPEC(9)), (PARENC,SPEC(10))
      EQUIVALENCE     (ALFNUM,TABLE(1)), (ALPHA,TABLE(11)),
     1                (NUMB,TABLE(1))
      EQUIVALENCE     (SPEC(1),SPECL)
C
      COMMON /RDCHAR/ TABLE, PLUS, MINUS, BLANK, PERIOD, SPEC
