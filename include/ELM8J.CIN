C ELM8J               MATRICES FOR BILINEAR TERMS AND MISALIGNMENT TABLE
C
C GT(5,6,6)       BILINEAR TERMS
C RC2M(36,6,10)   TRANSFER MATRIX FOR SYSTEM AFTER PARTICULAR 
C                     MISALIGNMENMT
C SIM(36,6,10)    ENVELOPE OF MISALIGNED BEAM
C COM(6,6,10)     DISPLACEMENT OF BEAM CENTROID FROM MISALIGNED MAGNET
C
      REAL            GT(5,6,6), RC2M(36,6,10), SIM(36,6,10), 
     1                COM(6,6,10)
C
      COMMON /ELM8J/  GT, RC2M, SIM, COM
