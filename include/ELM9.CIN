C ELM9                TYPE 9 -- REPEATS
C
C IC(4)         NUMBER OF PASSES REMAINING IN REPEAT SECTION
C IS(4)         NUM AT BEGINNING OF REPEAT SECTION
C IP            LEVEL OF NESTED REPEATS
C NREP          NUMBER OF REPEATS FOR SECTION
C
      INTEGER         IC(4), IS(4), IP, NREP
      INTEGER         NS(4)
      EQUIVALENCE     (IS(1),NS(1))
C
      COMMON /ELM9/   IC, IS, IP, NREP
