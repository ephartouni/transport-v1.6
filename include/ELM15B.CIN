C ELM15B              TYPE 15   UNIT NAMES
C
C XDIME    NAME OF OUTPUT UNIT
C XBEAM    NAME OF UNITS FOR BEAM DIMENSIONS
C XFLOOR   NAME OF UNITS FOR FLOOR COORDINATES
C XMIS     NAME OF UNITS FOR MISALIGNMENTS
C XNAME    NAME FOR NEW UNIT
C
      CHARACTER*4     XDIME(14), XBEAM(6), XFLOOR(2), XMIS(2), XNAME
C
      COMMON /ELM15B/ XDIME, XBEAM, XFLOOR, XMIS, XNAME
