C ELM38C              DIMENSIONS RELATED TO PLOTTING
C
C OPT        LOCAL ORIENTATION FOR PLOTTING
C XPT        LOCAL POSITION FOR PLOTTING
C HIGH       HEIGHT OF MAGNET FOR PLOT
C WIDE       WIDTH OF MAGNET FOR PLOT
C DANG       STEP SIZE FOR REFERENCE TRAJECTORY
C NANGS      NUMBER OF STEPS FOR REFERENCE TRAJECTORY
C NA         HORIZONTALLY PLOTTED COORDINATE
C ND         VERTICALLY PLOTTED COORDINATE
C
      INTEGER         NANGS, NA, ND
      REAL            OPT(3,3), XPT(3), HIGH, WIDE, DANG
C
      COMMON /ELM38C/ OPT, XPT, HIGH, WIDE, DANG, NANGS, NA, ND
