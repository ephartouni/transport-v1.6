C ELM8M       MISALIGNMENT TABLE DESCRIPTIVE PARAMETERS
C
C LMIS(2,10)   LIMITS OF ACCUMULATED LENGTH OF MISALIGNED SECTION
C NMTE(10)     LOCATION OF MISALIGNMENT SPECIFICATION FOR TABLE
C LNMT(10)     INDICATOR IF CONTRIBUTION TO TABLE HAS BEEN ACTIVATED.
C R2PM(10)     INDICATOR IF ACCUMULATION OF TRANSFER MATRIX FOR MISALIGNMENT 
C                        TABLE HAS BEGUN.
C CHORDT(10)   INDICATES IF MISALIGNMENT IS ALONG CHORD
C STRATE(10)   INDICATES MISALIGNMED ELEMENT HAS NO BENDS
C
      INTEGER         NMTE(10)
      LOGICAL         LNMT(10), R2PM(10), CHORDT(10), STRATE(10)
      REAL            LMIS(2,10)
C
      COMMON /ELM8M/  LMIS, NMTE, LNMT, R2PM, CHORDT, STRATE
