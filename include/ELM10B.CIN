C ELM10B              CONSTRAINTS AND VARIED PARAMETERS
C
C JCON      FIRST INDEX OF CONSTRAINT SPECIFICATION
C KCON      SECOND INDEX OF CONSTRAINT SPECIFICATION
C CTY       INDICATES UPPER OR LOWER LIMIT OF A CONSTRAINT.
C JV        INDEX TELLING WHICH PARAMETER OF AN ELEMENT IS BEING VARIED.
C NC        NUMBER OF CONSTRAINTS.
C NV1       NUMBER OF VARIED PARAMETERS ENCOUNTERED SO FAR.
C NV2       VARIED PARAMETER CURRENTLY BEING DEALT WITH.
C NV3       EXTRA STORAGE FOR NV1.
C NV2A      FIRST VARIABLE FOR SECOND DERIVATIVE
C NV2B      SECOND VARIABLE FOR SECOND DERIVATIVE
C
      COMMON /ELM10B/ JCON, KCON, CTY, JV, NC, NV1, NV2, NV3,
     1                NV2A, NV2B
      INTEGER         CTY
