C ELM16A              INPUT VALUES FOR SPECIAL PARAMETERS
C
C PARAM        VALUE OF SPECIAL PARAMETER
C BDBI         INPUT VALUE FOR BDB
C APBI(2)      INPUT VALUE OF MAGNET APERTURES
C LAYKI        INPUT VALUE FOR LAYK
C LAYLI        INPUT VALUE FOR LAYL
C LAYXI        INPUT VALUE FOR LAYX
C RAB1I        INPUT VALUE FOR RAB1
C RAB2I        INPUT VALUE FOR RAB2
C RMPSI        INPUT VALUE FOR RMPS
C VRNI         INPUT VALUE FOR VRN
C NPNI         INPUT VALUE FOR NPN
C BDBPI        INPUT VALUE FOR BDBP
C RNMSI        INPUT VALUE FOR RNMS
C GAMI         INPUT VALUE FOR GAM
C NPARS        INDEX OF SPECIAL PARAMETER
C
      INTEGER         NPARS
      REAL            PARAM, BDBI, APBI(2), LAYKI, LAYLI, LAYXI, RAB1I
      REAL            RAB2I, RMPSI, VRNI, NPNI, BDBPI, RNMSI, GAMI
C
      COMMON /ELM16A/ PARAM, BDBI, APBI, LAYKI, LAYLI, LAYXI, RAB1I,
     1                RAB2I, RMPSI, VRNI, NPNI, BDBPI, RNMSI, GAMI, 
     2                NPARS
