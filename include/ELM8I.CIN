C ELM8I              INTERMEDIATE QUANTITIES IN MISALIGNMENT CALCULATION
C
C XM(6)       LINEAR CENTROID DISPLACEMENT TERM
C XMB(6)      BILINEAR CENTROID DISPLACEMENT TERM
C DXM(6)      POSSIBLE CENTROID SHIFT WITHIN MISALIGNED SECTION
C GXXM(6)     BILINEAR MATRIX FOLDED WITH SIGMA MATRIX AND MISALIGNMENT 
C                      PARAMETERS
C
      REAL            XM(6), XMB(6), DXM(6), GXXM(6,6)
C
      COMMON /ELM8I/  XM, XMB, DXM, GXXM
