C ELM23               POINTERS TO STORAGE REGISTERS FOR ALGEBRAIC COMB.
C
C JREG                   NUMBER OF REGISTER FOR STORAGE OF RESULT
C K1REG                  FIRST INPUT REGISTER TO OPERATION
C K2REG                  SECOND INPUT REGISTER TO OPERATION
C JTIE                   INDICATES IF STORAGE IS IN REGISTER OR DATA
C K1TIE                  INDICATES IF STORAGE IS IN REGISTER OR DATA
C K2TIE                  INDICATES IF STORAGE IS IN REGISTER OR DATA
C IOPN                   NUMBER SPECIFYING OPERATION
C
      INTEGER         JREG, K1REG, K2REG, JTIE, K1TIE, K2TIE, IOPN
C
      COMMON /ELM23/  JREG, K1REG, K2REG, JTIE, K1TIE, K2TIE, IOPN
