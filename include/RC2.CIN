C RC2       FIRST-ORDER R2 MATRICES
C
C RC2       CUMULATIVE R MATRIX FROM LAST R2 UPDATE.
C R2V       CUMULATIVE PARTIALS MATRIX FROM LAST R2 UPDATE
C
      REAL            RC2(6,6), R2V(6,6,NPVAR)
      REAL            RC2L(36), R2VL(36,NPVAR)
      EQUIVALENCE     (RC2(1,1),RC2L(1)), (R2V(1,1,1),R2VL(1,1))
C
      COMMON /RC2/    RC2, R2V
