C	AN INCLUDE FILE TO STORE DATA TO BE WRITTRN TO FILE 23.
C	THE ELEMENT NAMES ARE ALREADY STORED IN ARRAY KELEM.
C	WE DEFINE A TWO DIMENSIONAL ARRAY OUTNEW (30,ISTLIM) WHERE
C	ISTLIM IS THE MAXIMUM NUMBER OF ELEMENTS PERMITTED.
C	1	LENGTH
C	2	BEND ANGLE
C	3	K1
C	4	K2
C	5	K3
C	6	TILT
C	7	ALPHAX
C	8 	BETAX
C	9	MUX (NOT AVAILABLE YET)
C	10	ETA X
C	11	ETA X'
C	12	ALPHAY
C	13	BETAY
C	14	MUY (NOT AVAILABLE YET)
C	15	ETA Y
C	16	ETA Y'
C	21	SUML=DISTANCE FROM START
C	22	X FLOOR
C	23	Y FLOOR
C	24	Z FLOOR
C	25	YAW
C	26	PITCH
C	27	ROLL
C	28-60	NOT YET DEFINED.
C	LOGICAL VARIABLE OUTNEWL ADDED TO SAY IF THIS ELEMENT OF THE
C	ARRAY OUTNEW HAS BEEN FILLED.
C
	LOGICAL          OUTNEWL (ISTLIM)
	COMMON /OUTNEWR/ OUTNEW (LOUTAR,ISTLIM), IOUTTYP(ISTLIM),
     1	                 OUTNEWL, ICOUNT
