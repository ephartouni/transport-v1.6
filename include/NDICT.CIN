C NDICT      DICTIONARY LIST SIZE
C
C NDICT      NUMBER OF POSSIBLE KEYWORDS FOR ELEMENT PARAMETERS
C NCPARA     NUMBER OF POSSIBLE POSITIONAL PARAMETERS
C NPORDR     INDICES OF KEYWORD PARAMETERS USED FOR POSITIONAL INPUT
C FILLIT     WHETHER UNSPECIFIED PARAMETERS ARE TO BE SET EQUAL TO ZERO
C MADNO      WHETHER "MAD" NOTATION IS USED
C
      LOGICAL         FILLIT, MADNO
      INTEGER         NDSAV, NCPARA, NPORDR(15)
C
      COMMON /NDICT/  NDSAV, NCPARA, NPORDR, FILLIT, MADNO
