C ELM17B              SECOND ORDER FITTING
C
C SEXMAX     LIMIT ON STRENGTH OF SEXTUPOLE GIVEN ON 10.N CARD.
C VARS(9)    TELLS IF SPECIAL PARAMETER IS BEING VARIED.
C SEXLIM     TRUE IF A LIMIT HAS BEEN IMPOSED ON THE SEXTUPOLE STRENGTHS 
C                    IN A SECOND ORDER RUN.
C
      INTEGER         VARS(9)
      LOGICAL         SEXLIM
      REAL            SEXMAX
C
      COMMON /ELM17B/ SEXMAX, VARS, SEXLIM
