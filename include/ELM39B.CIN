C ELM39B              LIMITS FOR VARIED PARAMETERS 
C  
C ALIM1                  LIMITS FOR BEAM PARAMETERS
C ALIM2                  LIMITS FOR POLE FACE ROTATION
C ALIM3                  LIMITS FOR DRIFT LENGTH
C ALIM4                  LIMITS FOR BEND MAGNET
C ALIM5                  LIMITS FOR QUADRUPOLE
C ALIM12                 LIMITS FOR BEAM MATRIX CORRELATIONS
C ALIM18                 LIMITS FOR SEXTUPOLE
C ALIM19                 LIMITS FOR SOLENOID
C ALIM20                 LIMITS FOR ROTATION ABOUT LONGITUDINAL AXIS
C ALIM25                 LIMITS FOR OCTUPOLE
C ALIM28                 LIMITS FOR RBEND AND SBEND
C ALIM34                 LIMITS FOR PLASMA LENS
C ALIM35                 LIMITS FOR HKICK OR VKICK
C
      REAL            ALIM1(4), ALIM2(4), ALIM3(4), ALIM4(4,6)
      REAL            ALIM5(4,5), ALIM12(4,15), ALIM18(4,4), ALIM19(4,3)
      REAL            ALIM20(4), ALIM25(4,4), ALIM28(4,13), ALIM34(4,5)
      REAL            ALIM35(4,4)
C
      COMMON /ELM39B/ ALIM1, ALIM2, ALIM3, ALIM4, ALIM5, ALIM12, ALIM18, 
     >                ALIM19, ALIM20, ALIM25, ALIM28, ALIM34, ALIM35
