C ELM24A              TYPE 24 -- DEFINE SECTION AND REPEATS
C
C JDEF          BEGINNING, END, OR CALLING OF DEFINED SECTION
C NADDEF(2)     BEGINNING AND END  OF DEFINED SECTION
C
      INTEGER         JDEF, NADDEF(2), NBEG, NEND
      EQUIVALENCE     (NBEG,NADDEF(1)), (NEND, NADDEF(2))
C
      COMMON /ELM24A/ JDEF, NADDEF
