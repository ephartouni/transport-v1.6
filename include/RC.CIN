C RC         FIRST-ORDER R1 MATRICES
C
C RC     CUMULATIVE R MATRIX FROM LAST R1 UPDATE THROUGH LAST R2 UPDATE.
C RCV    CUMULATIVE PARTIALS MATRIX FROM LAST R1 UPDATE THROUGH LAST R2 UPDATE
C
      REAL            RC(6,6), RCV(6,6,NPVAR)
      REAL            RCL(36), RCVL(36,NPVAR)
      EQUIVALENCE     (RC(1,1),RCL(1)), (RCV(1,1,1),RCVL(1,1))
C
      COMMON /RC/     RC, RCV
