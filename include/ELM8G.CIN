C ELM8G               INDEX FOR MISALIGNED SECTIONS
C
C NIU(3)      NUMBER OF MISALIGNMENTS REFERRING TO IMPLICIT UPDATES AT 
C		     BEGINNING OF BEAM LINE
C NIM(3,10)   ADDRESSES OF MISALIGNMENTS REFERRING TO IMPLICIT UPDATES
C NMTOT       TOTAL NUMBER OF MISALIGNMENTS
C NMIS        INDEX OF ELEMENT SPECIFYING MISALIGNMENT
C NMISE       INDEX OF ELEMENT BEING MISALIGNED
C NAL         COUNT WITHIN LIST OF MISALIGNMENTS INITIATED BY A GIVEN 
C             UPDATE
C NM4         LOCATION OF MISALIGNMENT SPECIFICATION FOR ALL SUBSEQUENT 
C		     BENDING MAGNETS
C NM5         LOCATION OF MISALIGNMENT SPECIFICATION FOR ALL SUBSEQUENT 
C		     QUADRUPOLES
C NUPD        NUMBER OF MISALIGNMENT ELEMENTS REFERRING TO A
C             PARTICULAR UPDATE
C
C NMISRB      BEGINNING OF SECTION OF MISALIGNMENTS BY NAME
C NMISRE      END OF SECTION OF MISALIGNMENTS BY NAME
C ALGR        TRUE IF PASSING THROUGH SECTION OF MISALIGNMENTS BY NAME
C
      INTEGER        NIU(3), NIM(3,10)
      LOGICAL        ALGR
C
      COMMON /ELM8G/ NIU, NIM, NMTOT, NMIS, NMISE, NAL, NM4, NM5, 
     1               NUPD, NMISRB, NMISRE, ALGR
