C ELM38B              INDICES RELATED TO PLOTTING
C
C JPLOT     FIRST INDEX OF A PLOT VARIABLE
C KPLOT     SECOND INDEX OF A PLOT VARIABLE
C NBPLOT    NUM FOR BEGINNING OF ALGEBRAIC OPERATIONS FOR QUANTITY 
C                     TO BE PLOTTED
C NPSAVE    NUMBER OF PARAMETERS USED FOR A DRIFT IN A MISALIGNMENT
C           CALCULATION
C
      INTEGER         JPLOT(10), KPLOT(10), NBPLOT, NPSAVE
C
      COMMON /ELM38B/ JPLOT, KPLOT, NBPLOT, NPSAVE
