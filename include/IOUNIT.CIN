C IOUNIT     FORTRAN I/O UNITS
C
C NIN        UNIT NUMBER FOR INPUT DATA.
C NOUT       UNIT NUMBER FOR PRINTOUT.
C NPUNCH     UNIT NUMBER FOR CARDS TO BE PUNCHED.
C NDATA      UNIT NUMBER FOR COMMON BLOCKS
C NPLOT      UNIT NUMBER FOR PLOT FILE
C
      INTEGER         NIN, NOUT, NPUNCH, NDATA, NPLOT
C
      COMMON /IOUNIT/ NIN, NOUT, NPUNCH, NDATA, NPLOT
