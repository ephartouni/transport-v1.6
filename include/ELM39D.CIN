C ELM39D              DEFAULT LIMITS FOR VARIED PARAMETERS
C
C ALM01               DEFAULT VALUES FOR BEAM MATRIX
C ALM02               DEFAULT VALUES FOR POLE FACE ROTATION
C ALM03               DEFAULT VALUES FOR DRIFT LENGTH
C ALM04               DEFAULT VALUES FOR BENDING MAGNET
C ALM05               DEFAULT VALUES FOR QUADRUPOLE
C ALM012              DEFAULT VALUES FOR BEAM MATRIX CORRELATIONS
C ALM018              DEFAULT VALUES FOR SEXTUPOLE
C ALM019              DEFAULT VALUES FOR SOLENOID
C ALM020              DEFAULT VALUES FOR ROTATION ABOUT LONGITUDINAL 
C                             AXIS
C ALM025              DEFAULT VALUES FOR OCTUPOLE
C ALM028              DEFAULT VALUES FOR RBEND AND SBEND
C ALMO34              DEFAULT VALUES FOR PLASMA LENS
C ALMO35              DEFAULT VALUES FOR RBEND AND SBEND
C
      REAL            ALM01(4), ALM02(4), ALM03(4), ALM04(4,6)
      REAL            ALM05(4,5), ALM012(4,15), ALM018(4,4), ALM019(4,3)
      REAL            ALM020(4), ALM025(4,4), ALM028(4,13), ALM034(4,5)
      REAL            ALM035(4,4)
C
      COMMON /ELM39D/ ALM01, ALM02, ALM03, ALM04, ALM05, ALM012, ALM018, 
     >                ALM019, ALM020, ALM025, ALM028, ALM034, ALM035
