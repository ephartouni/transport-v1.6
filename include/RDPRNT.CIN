C RDPRNT    CONTAINS CURRENT INPUT CARD (LINE)
C
C INDS      UNITS PART OF INDICATOR
C LIST      TRUE IF INITIAL LISTING OF DATA IS PRODUCED
C RFM       TRUE IF DATA ARE TO BE REFORMATTED
C BEF       TRUE IF BEAM LINE IS PRINTED BEFORE FITTING
C PRNT      TRUE IF BEAM LINE IS PRINTED AT ALL
C SLV       TRUE IF DATA ARE PROCESSED IN ANY WAY
C BWT       TRUE IF DATA ARE TO BE WRITTEN UNFORMATTED
C BRD       TRUE IF DATA ARE TO BE READ FROM UNFORMATTED FILE
C
      INTEGER         INDS
      LOGICAL         LIST, RFM, BEF, PRNT, SLV, BWT, BRD
C
      COMMON /RDPRNT/ INDS, LIST, RFM, BEF, PRNT, SLV, BWT, BRD
