C ELM4C      TYPE 4 BENDING MAGNET OR TYPE 5 QUADRUPOLE 
C         OR TYPE 18 SEXTUPOLE OR TYPE 25 OCTUPOLE 
C         OR TYPE 28 RBEND OR TYPE 29 SBEND
C
C K1         QUADRUPOLE STRENGTH = B'/(B*RHO)
C K1P        NORMALIZED MIDPLANE-ASYMMETRIC LINEAR DEPENDENCE OF FIELD
C K2         NORMALIZED QUADRATIC DEPENDENCE OF FIELD
C K2P        NORMALIZED MIDPLANE-ASYMMETRIC QUADRATIC DEPENDENCE OF FIELD
C K3         NORMALIZED CUBIC DEPENDENCE OF FIELD
C
      REAL            K1, K1P, K2, K2P, K3
C
      COMMON /ELM4C/  K1, K1P, K2, K2P, K3
