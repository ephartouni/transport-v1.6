C ELS8C       TEMPORARY STORAGE FOR ELM8C
C
C SIOLS      STORAGE FOR SIOL
C COLDS      STORAGE FOR COLD
C RCOS       STORAGE FOR RCO
C R2OS       STORAGE FOR R2O
C SPOS       STORAGE FOR SPO
C RCPOS      STORAGE FOR RCPO
C R2POS      STORAGE FOR R2PO
C
      LOGICAL         SPOS(3), RCPOS(3), R2POS
      REAL            SIOLS(3,6,6), COLDS(3,6), RCOS(3,6,6), R2OS(6,6)
C
      COMMON /ELS8C/  SIOLS, COLDS, RCOS, R2OS, SPOS, RCPOS, R2POS
