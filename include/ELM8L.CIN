C ELM8L               STORAGE FOR VALUE OF MISALIGNMENT PARAMETERS
C
C VMSAV(3,10,6)  STORAGE FOR VALUES OF VM (SO EXIT VALUES WILL BE THE SAME 
C                                          AS ENTRANCE VALUES)
C VMMAX          MAXIMUM MISALIGNMENT FOR A GIVEN ELEMENT
C IVMS           NUMBER OF SETS OF STORED VALUES OF VM
C
      INTEGER         IVMS(3)
      REAL            VMSAV(3,10,6), VMMAX
C
      COMMON /ELM8L/  VMSAV, VMMAX, IVMS
