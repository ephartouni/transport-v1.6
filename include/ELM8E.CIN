C ELM8E               BEAM MATRIX AT BEGINNING OF MISALIGNED SECTIONS
C
C SIOL(3,6,6)    SAVED SIGMA MATRIX
C COLD(3,6)      SAVED BEAM CENTROID
C RCO(3,6,6)     RC TRANSFER MATRIX AT BEGINNING OF MISALIGNED SECTION
C R2O(6,6)       R2 TRANSFER MATRIX AT BEGINNING OF MISALIGNED SECTION
C SPO            TRUE IF SAVED BEAM CENTROID MAY BE OFF AXIS
C RCPO(3)        TRUE IF ACCUMULATION OF RC HAD BEGUN AT BEGINNING OF 
C                        MISALIGNED SECTION
C R2PO           TRUE OF ACCUMULATION OF R2 HAD BEGIN AT BEGINNING OF 
C                        MISALIGNED SECTION
C
      LOGICAL         SPO(3), RCPO(3), R2PO
      REAL            SIOL(3,6,6), COLD(3,6), RCO(3,6,6), R2O(6,6)
C
      COMMON /ELM8E/  SIOL, COLD, RCO, R2O, SPO, RCPO, R2PO
