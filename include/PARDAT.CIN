C PARDAT     DESCRIPTORS FOR PHYSICAL PARAMETERS
C
C IPARM          LOCATION OF KEYWORD IN DICTIONARY
C IPTYP(MAXPAR)  INDICATES IF KEYWORD IS PRESENT AND IF VALUE 
C                IS ASSIGNED
C IPDAT(MAXPAR)  INDICATES IF PARAMETERS ARE TO BE VARIED
C IOPERS(MAXPAR) INDICATES IF PARAMETER INVOLVES ALGEBRAIC OPERATIONS
C
      INTEGER         IPARM, IPTYP(MAXPAR), IPDAT(MAXPAR), 
     1                IOPERS(MAXPAR)
C
      COMMON /PARDAT/ IPARM, IPTYP, IPDAT, IOPERS
