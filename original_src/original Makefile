	for i in $(TRANSPORT_COMS); do \
		(cp $(TRANSPORT_INC)/$$i $(TRANSNEW_INC)/$$i); \
	done
	@echo "dev transport.com copied to new transport.com"

turtle-coms:
	for i in $(TURTLE_COMS); do \
		(cp $(TURTLE_INC)/$$i $(TRANSNEW_INC)/$$i); \
	done
	@echo "dev turtle.com copied to new transport.com"

